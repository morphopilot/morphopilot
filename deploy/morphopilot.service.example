[Unit]
Description=MorphoPilot annotation workspace
After=network.target

[Service]
Type=simple
User=morphopilot
Group=morphopilot
WorkingDirectory=/opt/morphopilot
ExecStart=/usr/bin/bash /opt/morphopilot/deploy/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
